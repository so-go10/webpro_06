<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>好きな格闘技</title>
</head>
<body>
  <h2>格闘技一覧</h2>
  <table border="1">
    <tr>
      <th>ID</th>
      <th>格闘技名</th>
      <th>種類</th>
      <th>特徴</th>
    </tr>
    <% for (let row of data) { %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.name %></td>
        <td><%= row.category %></td>
        <td><%= row.feature %></td>
      </tr>
    <% } %>
  </table>
</body>
</html>